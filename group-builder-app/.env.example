# ─── Database (Neon PostgreSQL) ───────────────────────────────────────────────
# Get this from your Neon project dashboard → Connection Details → Connection string
# Format: postgresql://<user>:<password>@<host>/<dbname>?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# ─── NextAuth.js ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here"
# Your production URL (for Vercel deployments)
NEXTAUTH_URL="http://localhost:3000"

# ─── Application-layer encryption (AES-256-GCM) ───────────────────────────────
# Generate with: openssl rand -hex 32
# This 64-char hex string = 32 bytes = 256-bit key
ENCRYPTION_KEY="your-64-char-hex-encryption-key-here"

# ─── HMAC for duplicate detection ─────────────────────────────────────────────
# Generate with: openssl rand -hex 32
HMAC_SECRET="your-64-char-hex-hmac-secret-here"

# ─── App config ───────────────────────────────────────────────────────────────
# Set to "development" locally, "production" on Vercel
NODE_ENV="development"
