// Shepherd's Grouping System — Prisma Schema
// Neon PostgreSQL (serverless) — pair with @prisma/client

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  SHEPHERD
  VIEWER
}

enum Gender {
  MALE
  FEMALE
}

enum RoomGender {
  MALE
  FEMALE
  MIXED
}

enum RelationshipType {
  CLASSMATE
  SIBLING
  FAMILY
  CHURCHMATE
  BARKADA
  OTHER
}

enum ConnectionSource {
  AUTO
  MANUAL
}

enum ConflictStatus {
  ACTIVE
  DISMISSED
}

// ─── Organization ─────────────────────────────────────────────────────────────

model Organization {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique  // e.g. "bld-youth-ministry"
  isBld     Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  users   User[]
  events  Event[]
  config  OrgConfig?
}

// ─── OrgConfig ────────────────────────────────────────────────────────────────

model OrgConfig {
  id               String  @id @default(cuid())
  orgId            String  @unique
  termCandidate    String? // BLD: "Lamb"          | generic: "Participant"
  termGroup        String? // BLD: "Kordero"        | generic: "Group"
  termEvent        String? // BLD: "YE Batch"       | generic: "Event"
  termShepherd     String? // BLD: "Shepherd"       | generic: "Facilitator"
  termHeadShepherd String? // BLD: "Head Shepherd"  | generic: "Admin"
  features         Json    @default("{}") // { importExcel }
  primaryColor     String?
  logoUrl          String?

  org Organization @relation(fields: [orgId], references: [id])
}

// ─── Users (Shepherds) ────────────────────────────────────────────────────────

model User {
  id           String        @id @default(cuid())
  email        String
  passwordHash String
  name         String
  role         Role          @default(SHEPHERD)
  orgId        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  org        Organization? @relation(fields: [orgId], references: [id])
  activities Activity[]

  @@unique([email, orgId])
  @@index([orgId])
}

// ─── Event ────────────────────────────────────────────────────────────────────

model Event {
  id                   String      @id @default(cuid())
  name                 String      // e.g. "YE #19"
  isActive             Boolean     @default(false)
  featureVisualizer    Boolean     @default(false)
  featureRoomAssignment Boolean    @default(false)
  orgId                String?
  createdAt            DateTime    @default(now())

  org        Organization? @relation(fields: [orgId], references: [id])
  candidates Candidate[]
  groups     Group[]
  rooms      Room[]

  @@unique([name, orgId])
  @@index([orgId])
}

// ─── Candidate (Lamb) ─────────────────────────────────────────────────────────
// Sensitive PII fields are encrypted at the application layer (AES-256-GCM)
// before write and decrypted on read via Prisma middleware in lib/prisma.ts.
// Fields used for sorting/filtering (fullName, gender, age, batch) stay plaintext.

model Candidate {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())

  // Plaintext — used for search, sort, display
  fullName  String
  lastName  String
  firstName String
  gender    Gender
  age       Int?
  school    String?
  inviterName String?
  howHeard  String?
  yeBatch   String   // e.g. "YE #19"

  // Encrypted PII columns (stored as base64 "iv:tag:ciphertext")
  birthdayEnc      String?  // Date as ISO string, encrypted
  addressEnc       String?
  facebookEnc      String?
  contactEnc       String?  // primary unique identifier for duplicates
  contactHash      String?  // HMAC-SHA256 for duplicate detection without decryption
  fatherNameEnc    String?
  fatherContactEnc String?
  motherNameEnc    String?
  motherContactEnc String?
  allergiesEnc     String?  // flagged visually on cards
  shepherdNotesEnc String?  // internal only

  isConfirmed      Boolean  @default(false)

  // Assignments
  groupId String?
  roomId  String?
  eventId String

  event           Event        @relation(fields: [eventId], references: [id])
  group           Group?       @relation(fields: [groupId], references: [id])
  room            Room?        @relation(fields: [roomId], references: [id])
  connectionsFrom Connection[] @relation("FromCandidate")
  connectionsTo   Connection[] @relation("ToCandidate")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
  @@index([contactHash])
  @@index([groupId])
  @@index([roomId])
}

// ─── Connection (Relationship Graph Edge) ─────────────────────────────────────

model Connection {
  id               String           @id @default(cuid())
  fromId           String
  toId             String
  eventId          String           @default("")
  relationshipType RelationshipType
  source           ConnectionSource
  note             String?
  confirmed        Boolean          @default(true)

  from      Candidate @relation("FromCandidate", fields: [fromId], references: [id], onDelete: Cascade)
  to        Candidate @relation("ToCandidate", fields: [toId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([fromId, toId])  // one edge per direction; check both directions in queries
  @@index([fromId])
  @@index([toId])
  @@index([eventId])
}

// ─── Group ────────────────────────────────────────────────────────────────────

model Group {
  id       String  @id @default(cuid())
  name     String  // e.g. "Kordero 1"
  label    String? // optional alias
  capacity Int     @default(12)
  order    Int     @default(0)
  isLocked Boolean @default(false)
  eventId  String

  event      Event       @relation(fields: [eventId], references: [id])
  candidates Candidate[]
  conflicts  Conflict[]  @relation("GroupConflicts")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
}

// ─── Room ─────────────────────────────────────────────────────────────────────

model Room {
  id       String     @id @default(cuid())
  name     String
  floor    String?
  building String?
  capacity Int
  bedCount Int
  gender   RoomGender
  eventId  String

  event      Event       @relation(fields: [eventId], references: [id])
  candidates Candidate[]
  conflicts  Conflict[]  @relation("RoomConflicts")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
}

// ─── Conflict ─────────────────────────────────────────────────────────────────

model Conflict {
  id           String         @id @default(cuid())
  candidateAId String
  candidateBId String
  groupId      String?
  roomId       String?
  status       ConflictStatus @default(ACTIVE)
  shepherdNote String?
  dismissedBy  String?
  dismissedAt  DateTime?

  group     Group?   @relation("GroupConflicts", fields: [groupId], references: [id])
  room      Room?    @relation("RoomConflicts", fields: [roomId], references: [id])
  createdAt DateTime @default(now())

  @@index([groupId])
  @@index([roomId])
}

// ─── Activity Log ─────────────────────────────────────────────────────────────

model Activity {
  id          String   @id @default(cuid())
  userId      String
  action      String   // "created", "updated", "deleted", "assigned", "imported"
  entityType  String   // "candidate", "group", "room", "connection"
  entityId    String?
  description String
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}
